# 必填，无默认值。填入与 DRF 的 SIMPLE_JWT.SIGNING_KEY 相同的值。
JWT_SIGNING_KEY=

# 以下为服务默认值。认证 Redis 的库号必须与 DRF 的 DEFAULT_CACHE_ID 一致。
AUTH_REDIS_URL=redis://127.0.0.1:6379/1
AUTH_REDIS_TIMEOUT=0.5
DRF_BASE_URL=http://127.0.0.1:8896
HTTP_CONNECT_TIMEOUT=1.0
HTTP_READ_TIMEOUT=3.0
DRF_TOTAL_TIMEOUT=5.0
HTTP_MAX_CONNECTIONS=32
UPSTREAM_CONCURRENCY=16
UPSTREAM_SLOT_TIMEOUT=1.0
DRF_MAX_RETRIES=2

# 仅供 pytest 使用，无默认值。启用真实 Redis 测试时在测试进程环境中设置。
# AUTH_TEST_REDIS_URL=redis://127.0.0.1:56379/1
